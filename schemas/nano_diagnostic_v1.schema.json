{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cellguard.local/schemas/nano_diagnostic_v1.schema.json",
  "title": "nano_diagnostic_v1",
  "description": "Nano diagnostics that are neither measurements (normalized_sample_v1) nor fault events (fault_event_v1): CGY on-load tap suspects (never a cell voltage), CGX trip snapshots, rested re-check results, 0.1.6 stage events, and the Pi's cycle verdicts. Author: Yongho Ahn <nanhosoft@gmail.com>",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "source", "scenario_domain", "device_id", "pack_id", "run_id", "scenario_id",
               "diag_id", "kind", "timestamp_utc", "t_sim_s", "pi_received_utc", "nano_millis", "frame",
               "raw_log_ref", "firmware_version", "detail"],
  "properties": {
    "schema_version": {"const": "nano_diagnostic_v1"},
    "source": {"enum": ["synthetic", "measured_normal"]},
    "scenario_domain": {"enum": ["simulation_only", "measured_hardware"]},
    "device_id": {"type": "string"},
    "pack_id": {"type": "string"},
    "run_id": {"type": "string"},
    "scenario_id": {"type": "string"},
    "diag_id": {"type": "string"},
    "kind": {"enum": ["LOAD_TAP_SUSPECT_SNAPSHOT", "TRIP_SNAPSHOT", "REST_VERIFY", "NANO_EVENT", "STAGE_STOP",
                      "CYCLE_STAGE", "CYCLE_RESULT"]},
    "timestamp_utc": {"type": "string"},
    "t_sim_s": {"type": "number", "minimum": 0},
    "pi_received_utc": {"type": ["string", "null"]},
    "nano_millis": {"type": ["integer", "null"]},
    "frame": {"type": ["string", "null"], "description": "the received frame as it was on the wire"},
    "raw_log_ref": {"type": "string"},
    "firmware_version": {"type": "string"},
    "detail": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "LOAD_TAP_SUSPECT_SNAPSHOT"}}},
     "then": {"properties": {"detail": {"required": ["direction", "measured_under_load", "rested_cell_voltage",
                                                     "adc_tap_raw", "tap_mv_under_load", "bandgap_raw"],
                                        "properties": {"rested_cell_voltage": {"const": false},
                                                       "measured_under_load": {"const": true}}}}}},
    {"if": {"properties": {"kind": {"const": "TRIP_SNAPSHOT"}}},
     "then": {"properties": {"detail": {"required": ["trip_code", "trip_reason", "adc_tap_raw", "tap_mv",
                                                     "bandgap_raw", "voltage_quality_bits", "hardware_trip"]}}}},
    {"if": {"properties": {"kind": {"const": "REST_VERIFY"}}},
     "then": {"properties": {"detail": {"required": ["reason", "rested_voltage_ok", "stage_successful"],
                                        "properties": {"stage_successful": {"const": false}}}}}},
    {"if": {"properties": {"kind": {"const": "STAGE_STOP"}}},
     "then": {"properties": {"detail": {"required": ["stage", "reason", "stop_class", "nano_target_reached"],
                                        "properties": {"stop_class": {"enum": ["TARGET_REACHED", "ABORTED",
                                                       "LIMIT", "TRIP", "HOST_STOP"]}}}}}},
    {"if": {"properties": {"kind": {"const": "CYCLE_RESULT"}}},
     "then": {"properties": {"detail": {"required": ["outcome", "stages"],
                                        "properties": {"outcome": {"enum": ["PASS", "ABORTED"]}}}}}}
  ]
}
